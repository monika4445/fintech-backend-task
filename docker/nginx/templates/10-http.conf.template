# NGINX_LOCAL_RESOLVERS приходит из штатного 15-local-resolvers.envsh образа
# (включается переменной NGINX_ENTRYPOINT_LOCAL_RESOLVERS) и содержит адрес
# встроенного DNS докера. valid=10s заставляет перепроверять адрес апстрима,
# а не кэшировать его навсегда.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

# Запрос с чужим Host не должен попадать в основной блок только потому, что тот
# оказался первым в конфиге. 444 закрывает соединение без ответа.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    # ACME-челлендж обязан остаться на HTTP и не редиректиться,
    # иначе certbot не сможет подтвердить домен.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
