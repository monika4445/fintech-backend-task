# NGINX_LOCAL_RESOLVERS приходит из штатного 15-local-resolvers.envsh образа
# (включается переменной NGINX_ENTRYPOINT_LOCAL_RESOLVERS) и содержит адрес
# встроенного DNS докера. valid=10s заставляет перепроверять адрес апстрима,
# а не кэшировать его навсегда.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

# JSON-ответы уходили несжатыми: проверено, Accept-Encoding: gzip ничего не
# менял. На типичном ответе API в единицы килобайт это троекратная переплата за
# исходящий трафик и соответствующий TTLB на мобильных сетях.
# min_length отсекает мелочь, где накладные расходы сжатия больше выигрыша.
gzip              on;
gzip_vary         on;
gzip_min_length   1024;
gzip_comp_level   5;
gzip_proxied      any;
gzip_types        application/json application/javascript text/css text/plain
                  application/xml image/svg+xml;

# Ограничение частоты на периметре. Без него один клиент способен занять всю
# ёмкость пула воркеров, и это выглядит как отказ сервиса для всех остальных.
# Зона на 10 МБ вмещает порядка 160 тысяч адресов.
limit_req_zone    $binary_remote_addr zone=api:10m rate=${RATE_LIMIT_RPS}r/s;
limit_req_status  429;

server {
    listen 80 default_server;
    server_name _;

    # Healthcheck ходит на 127.0.0.1 без заголовка Host, поэтому попадает
    # именно сюда, а не в блок домена. Отвечает без обращения к приложению:
    # это проверка живости nginx, а не сквозная проверка стека.
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    # Запрос с чужим Host не должен попадать в основной блок только потому, что
    # тот оказался первым в конфиге. 444 закрывает соединение без ответа.
    # Именно location, а не return на уровне server: серверный return
    # отрабатывает в фазе rewrite до выбора location и перебил бы healthcheck.
    location / {
        return 444;
    }
}
