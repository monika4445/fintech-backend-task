# Режим первого запуска: сертификата ещё нет.
# Выбирается скриптом 40-select-tls-mode.sh, парный файл 10-http-redirect.conf.
#
# Редирект на https здесь увёл бы клиента в никуда: 443 никто не слушает.
# Раньше этот режим получался правкой соседнего файла через sed, привязанный к
# отступу и точной формулировке строки. Любое переформатирование шаблона делало
# бы его тихим no-op с кодом возврата 0. Два отдельных файла убирают этот класс
# ошибки полностью.
server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        limit_req zone=api burst=${RATE_LIMIT_BURST} nodelay;
        include /etc/nginx/conf.d/proxy_params.inc;
    }
}
