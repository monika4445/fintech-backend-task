# Подключается через include внутри location. Расширение .inc, а не .conf,
# намеренно: nginx.conf сам подключает /etc/nginx/conf.d/*.conf на уровне http,
# и .conf здесь означал бы двойное включение с ошибкой запуска.

# proxy_pass через переменную, а не через upstream-блок. Причина измерена вживую:
# со статическим `upstream django { server app:8000; }` nginx резолвит имя один
# раз при старте и держит IP до перезапуска. После `docker compose up -d app`
# контейнер получает новый адрес, и nginx отдаёт 502 на каждый запрос
# ("connect() failed (113: Host is unreachable) ... upstream: 172.18.0.5:8000"),
# то есть штатный деплой приложения кладёт сайт до ручного рестарта прокси.
#
# Размен, который здесь сделан осознанно: с переменной в proxy_pass пропадает
# пул keepalive до gunicorn, каждый запрос открывает новое TCP-соединение внутри
# docker-сети. Это доли миллисекунды, а альтернатива это 502 на каждом деплое.
#
# $request_uri обязателен: при использовании переменной nginx НЕ подставляет
# совпавшую часть URI автоматически, и без него все запросы уедут в корень.
set $upstream_app "http://app:8000";
proxy_pass $upstream_app$request_uri;

proxy_http_version 1.1;
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
# Без этого заголовка (в паре с SECURE_PROXY_SSL_HEADER в Django) включённый
# SECURE_SSL_REDIRECT уводит клиента в бесконечный редирект: за прокси Django
# видит http и редиректит на https снова и снова.
proxy_set_header X-Forwarded-Proto $scheme;
proxy_redirect off;

proxy_connect_timeout 5s;
proxy_read_timeout    60s;
