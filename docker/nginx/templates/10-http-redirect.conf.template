# Обычный режим: сертификат есть, весь HTTP уходит на HTTPS.
# Выбирается скриптом 40-select-tls-mode.sh, парный файл 10-http-direct.conf.
server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    # ACME-челлендж обязан остаться на HTTP и не редиректиться,
    # иначе certbot не сможет подтвердить домен при продлении.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
