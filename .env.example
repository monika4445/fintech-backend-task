# Единственное место, где живёт домен. Его читают nginx (server_name,
# пути к сертификатам) и Django (ALLOWED_HOSTS). Смена значения плюс
# `docker compose up -d --force-recreate nginx app` — пересборка образа не нужна.
DOMAIN=example.com

SECRET_KEY=change-me
DEBUG=0

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
