# Единственное место, где живёт домен. Его читают nginx (server_name, пути к
# сертификатам) и Django (ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS). Смена значения
# плюс `docker compose up -d --force-recreate nginx app` — пересборка образа
# не нужна.
DOMAIN=example.com

# Обязателен. Дефолта в коде намеренно нет: приложение с публично известным
# ключом позволяет подделать сессионные куки и токены сброса пароля.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

DEBUG=0
LOG_LEVEL=INFO
TIME_ZONE=Europe/Moscow

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=

# Локальный запуск на нестандартных портах, чтобы не требовать root.
# HTTP_PORT=8080
# HTTPS_PORT=8443

# Ограничение частоты на периметре (nginx).
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# Пул соединений на стороне приложения. DB_POOL=0 нужен только если впереди
# стоит PgBouncer в transaction mode: два пула подряд мешают друг другу.
DB_POOL=1
DB_POOL_MIN=2
DB_POOL_MAX=10

LOG_FORMAT=json
